# Application
HELLNET_SERVICE=fast-platform-modular
HELLNET_ENV=development
GIN_MODE=debug

# Database
HELLNET_DATABASE_HOST=localhost
HELLNET_DATABASE_PORT=5432
HELLNET_DATABASE_NAME=fast
HELLNET_DATABASE_USERNAME=fast
HELLNET_DATABASE_PASSWORD=fast
HELLNET_DATABASE_SSL_MODE=disable

# Kafka (local development - PLAINTEXT)
HELLNET_KAFKA_BROKERS=localhost:9092
HELLNET_KAFKA_SECURITY_PROTOCOL=plaintext
HELLNET_KAFKA_SASL_MECHANISM=
HELLNET_KAFKA_SASL_USERNAME=
HELLNET_KAFKA_SASL_PASSWORD=
HELLNET_KAFKA_TOPIC_ORDER_REQUESTED=fast-order-requested
HELLNET_KAFKA_TOPIC_ORDER_ACCEPTED=fast-order-accepted
HELLNET_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Telemetry (optional - leave empty for no-op)
HELLNET_TELEMETRY_ENDPOINT=
HELLNET_TELEMETRY_OTLP=true
HELLNET_TELEMETRY_PROFILING=auto

# HTTP Server
HELLNET_HTTP_HOST=0.0.0.0
HELLNET_HTTP_PORT=8080
HELLNET_HTTP_READ_TIMEOUT=15s
HELLNET_HTTP_WRITE_TIMEOUT=15s
HELLNET_HTTP_IDLE_TIMEOUT=60s